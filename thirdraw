clc;
clear;

% Connect to Arduino
a = arduino('COM5', 'MKR1010');  % Adjust COM port if needed

% Read voltages corresponding to pixels 3, 7, 11, and 15
v3  = readVoltage(a, 'A0');  % Pixel 3 (Gray)
v7  = readVoltage(a, 'A1');  % Green signal
v11 = readVoltage(a, 'A2');  % Purple signal
v15 = readVoltage(a, 'A3');  % Pixel 15 (Gray)

% Convert voltages to 0–255 scale
to255 = @(v) uint8(min(floor((v / 3.3) * 255), 255));
voltages = [v3, v7, v11, v15];
values255 = to255(voltages);

% Create empty 4×4×3 RGB matrix
rgb_img = zeros(4, 4, 3, 'uint8');

%% Assign pixel colors

% Pixel 3 → grayscale
gray3 = [values255(1), values255(1), values255(1)];
rgb_img(1, 3, :) = gray3;

% Combine 7 (green) and 11 (purple)
green_val  = values255(2);
purple_val = values255(3);

% Base RGB components
% Green = [0, g, 0]
% Purple = [p, 0, p]
% Combined color adds them together
combined_rgb = [purple_val, green_val, purple_val];
combined_rgb = uint8(min(combined_rgb, 255));

% Noise threshold
threshold = 10;

% Decide final color based on active channels
if green_val > threshold && purple_val <= threshold
    combined_rgb = [0, green_val, 0];                % only green active
elseif purple_val > threshold && green_val <= threshold
    combined_rgb = [purple_val, 0, purple_val];      % only purple active
elseif green_val <= threshold && purple_val <= threshold
    combined_rgb = [0, 0, 0];                        % both off
end

% Apply combined color to middle pixels (rows 2 & 3, column 3)
rgb_img(2, 3, :) = combined_rgb;
rgb_img(3, 3, :) = combined_rgb;

% Pixel 15 → grayscale
gray15 = [values255(4), values255(4), values255(4)];
rgb_img(4, 3, :) = gray15;

%% Detect Screens
monitors = get(0, 'MonitorPositions');
primary_pos = monitors(1, :);
if size(monitors, 1) >= 2
    second_pos = monitors(2, :);
else
    second_pos = monitors(1, :);
end

%% Primary Screen: Display Voltages
fig1 = figure('Name', 'Adaptive Mixed Column (3,7+11,15)', ...
              'NumberTitle', 'off', ...
              'MenuBar', 'none', ...
              'ToolBar', 'none', ...
              'Units', 'pixels', ...
              'Position', [primary_pos(1)+100, primary_pos(2)+100, 550, 440]);

labels = {
    sprintf('Pixel 3 (Gray, A0): %.2f V → %d', v3, values255(1))
    sprintf('Green (Pin 7, A1): %.2f V → %d', v7, green_val)
    sprintf('Purple (Pin 11, A2): %.2f V → %d', v11, purple_val)
    sprintf('Pixel 15 (Gray, A3): %.2f V → %d', v15, values255(4))
};

for i = 1:4
    uicontrol('Style', 'text', 'Units', 'normalized', ...
        'Position', [0.1, 0.85 - (i-1)*0.2, 0.8, 0.15], ...
        'FontSize', 15, ...
        'String', labels{i});
end
drawnow;

%% Second Screen: Display Image
screenW = second_pos(3);
screenH = second_pos(4);
big_img = imresize(rgb_img, [screenH, screenW], 'nearest');

fig2 = figure('MenuBar', 'none', 'ToolBar', 'none', ...
              'NumberTitle', 'off', 'Color', 'black', ...
              'Units', 'pixels', ...
              'Position', second_pos);

try
    set(fig2, 'WindowState', 'fullscreen');
catch
end

ax = axes('Parent', fig2, 'Units', 'normalized', 'Position', [0 0 1 1]);
imshow(big_img, 'Parent', ax);
axis off;

% Save image
imwrite(big_img, 'adaptive_mixed_column_3_7_11_15.jpeg', 'JPEG');
