clc;
clear;

% Connect to Arduino
a = arduino('COM5', 'MKR1010');

% Read voltages from analog pins
v6 = readVoltage(a, 'A0');
v7 = readVoltage(a, 'A1');
v10 = readVoltage(a, 'A2');
v11 = readVoltage(a, 'A3');

% Convert voltages to 0–255
to255 = @(v) uint8(min(floor((v / 3.3) * 255), 255));
r10 = to255(v10); g6 = to255(v6); b10 = r10; % purple from pin 10, green from pin 6
r11 = to255(v11); g7 = to255(v7); b11 = r11; % purple from pin 11, green from pin 7

% Create 4x4x3 RGB matrix
rgb_img = zeros(4, 4, 3, 'uint8');

% Elongated rectangle for pixels 6 (row2,col2) + 10 (row3,col2)
rgb_img(2, 2, :) = [r10, g6, b10];  % top part
rgb_img(3, 2, :) = [r10, g6, b10];  % bottom part

% Elongated rectangle for pixels 7 (row2,col3) + 11 (row3,col3)
rgb_img(2, 3, :) = [r11, g7, b11];  % top part
rgb_img(3, 3, :) = [r11, g7, b11];  % bottom part

%% Display info
monitors = get(0, 'MonitorPositions');
primary_pos = monitors(1, :);
if size(monitors,1) >= 2
    second_pos = monitors(2,:);
else
    second_pos = monitors(1,:);
end

fig1 = figure('Name', 'Elongated Color Pixels', ...
              'NumberTitle', 'off', 'MenuBar', 'none', ...
              'ToolBar', 'none', 'Units', 'pixels', ...
              'Position', [primary_pos(1)+100, primary_pos(2)+100, 600, 400]);

% Info display
labels = {
    sprintf('Pins 6 + 10 → Green+Purple: G=%.2f V, P=%.2f V', v6, v10), ...
    sprintf('Pins 7 + 11 → Green+Purple: G=%.2f V, P=%.2f V', v7, v11)
};
for i = 1:2
    uicontrol('Style', 'text', 'Units', 'normalized', ...
        'Position', [0.1, 0.7 - (i-1)*0.2, 0.8, 0.15], ...
        'FontSize', 14, ...
        'String', labels{i});
end
drawnow;

%% Display on second screen
screenW = second_pos(3);
screenH = second_pos(4);
big_img = imresize(rgb_img, [screenH, screenW], 'nearest');

fig2 = figure('MenuBar', 'none', 'ToolBar', 'none', ...
              'NumberTitle', 'off', 'Color', 'black', ...
              'Units', 'pixels', 'Position', second_pos);
try
    set(fig2, 'WindowState', 'fullscreen');
catch
end

ax = axes('Parent', fig2, 'Units', 'normalized', 'Position', [0 0 1 1]);
imshow(big_img, 'Parent', ax);
axis off;

% Save result
imwrite(big_img, 'elongated_pixel_6_7_10_11.jpeg', 'JPEG');
