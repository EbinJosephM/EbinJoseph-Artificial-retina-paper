clc;
clear;

% Connect to Arduino on COM5
a = arduino('COM5', 'MKR1010');

% Read voltages from analog pins
v5  = readVoltage(a, 'A0');   % Replace with A5 if that's the actual pin
v8  = readVoltage(a, 'A1');   % Replace with A8 if that's the actual pin
v9  = readVoltage(a, 'A2');   % Replace with A9 if that's the actual pin
v12 = readVoltage(a, 'A3');   % Replace with A12 if that's the actual pin

% Convert to grayscale
voltages = [v5, v8, v9, v12];
gray_values = floor((voltages / 3.3) * 255);
gray_values = min(gray_values, 255);

% Create blank 4x4 matrix
gray_matrix = zeros(4, 4);

% Assign to correct positions
gray_matrix(2,1) = gray_values(1);  % index 5
gray_matrix(2,4) = gray_values(2);  % index 8
gray_matrix(3,1) = gray_values(3);  % index 9
gray_matrix(3,4) = gray_values(4);  % index 12

%% Display Voltages on Primary Screen
monitors = get(0, 'MonitorPositions');
primary_pos = monitors(1, :);
if size(monitors, 1) >= 2
    second_pos = monitors(2, :);
else
    second_pos = monitors(1, :);
end

fig1 = figure('Name', 'Voltage Readings for 4x4 Mapping', ...
              'NumberTitle', 'off', 'MenuBar', 'none', ...
              'ToolBar', 'none', 'Units', 'pixels', ...
              'Position', [primary_pos(1)+100, primary_pos(2)+100, 500, 400]);

pin_labels = {'A5 → index 5', 'A8 → index 8', 'A9 → index 9', 'A12 → index 12'};
for i = 1:4
    uicontrol('Style', 'text', 'Units', 'normalized', ...
        'Position', [0.1, 0.85 - (i-1)*0.2, 0.8, 0.15], ...
        'FontSize', 16, ...
        'String', sprintf('%s: %.2f V → %d', ...
            pin_labels{i}, voltages(i), gray_values(i)));
end

drawnow;

%% Show Image on Second Screen
screenW = second_pos(3);
screenH = second_pos(4);
big_img = imresize(gray_matrix, [screenH, screenW], 'nearest');

fig2 = figure('MenuBar', 'none', 'ToolBar', 'none', ...
              'NumberTitle', 'off', 'Color', 'black', ...
              'Units', 'pixels', 'Position', second_pos);
try
    set(fig2, 'WindowState', 'fullscreen');
catch
end

ax = axes('Parent', fig2, 'Units', 'normalized', 'Position', [0 0 1 1]);
imshow(uint8(big_img), 'Parent', ax);
axis off;

imwrite(uint8(big_img), 'gray_4x4_selected_indices.jpeg', 'JPEG');
